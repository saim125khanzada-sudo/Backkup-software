# =================================================================
# Enterprise Endpoint Backup & Sync - Environment Configuration
# =================================================================

PROJECT_NAME="Enterprise Backup & Sync Platform"

# PostgreSQL Configuration
POSTGRES_USER=backup_admin
POSTGRES_PASSWORD=SecurePass2026
POSTGRES_DB=enterprise_backup
DATABASE_URL=postgresql+asyncpg://backup_admin:SecurePass2026@postgres:5432/enterprise_backup

# Security & JWT Tokens
SECRET_KEY=change-to-a-very-secure-random-64-character-string-in-production-now
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# File Storage Root
STORAGE_ROOT=/data/storage

# Default Initial Administrator Account
DEFAULT_ADMIN_EMAIL=admin@enterprise.local
DEFAULT_ADMIN_PASSWORD=AdminPass123!
DEFAULT_ADMIN_NAME="IT System Administrator"

# Default Storage Quota Per User (50 GB in bytes: 50 * 1024 * 1024 * 1024)
DEFAULT_USER_QUOTA_BYTES=53687091200